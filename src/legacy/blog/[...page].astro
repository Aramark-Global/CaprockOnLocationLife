---
import type { GetStaticPaths, Page } from "astro";
import { getCollection } from "astro:content";
import { getLocaleFromUrl, filterCollectionByLanguage } from "@js/localeUtils";
import { useTranslations } from "@js/translationUtils";
import { defaultLocale } from "@config/siteSettings";
import BaseLayout from "@layouts/BaseLayout.astro";
import Banner from "@components/Banner/Banner.astro";
import BlogPreview from "@components/BlogPreview/BlogPreview.astro";
import Pagination from "@components/Pagination/Pagination.astro";
import CTA from "@components/CTA/CTA.astro";

export const getStaticPaths = (async ({ paginate }) => {
	const allPosts = await getCollection("blog");
	const enPosts = filterCollectionByLanguage(allPosts, defaultLocale);
	const sortedPosts = enPosts.sort(
		(a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf(),
	);
	return paginate(sortedPosts, { pageSize: 6 });
}) satisfies GetStaticPaths;

import bannerImg from "@assets/images/sample-images/coyote-bluff-amarillo-1024x768.jpg";

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const { page } = Astro.props as { page: Page };
---

<BaseLayout title={t("blog:landing")} description={t("blog:title")}>
	<Banner title={t("blog:landing")} image={bannerImg} eyebrow={t("blog:topper")} />

	<section class="cap-section cap-section--dark cap-blog-section">
		<div class="cap-container">
			<header class="cap-section-head">
				<span class="cap-eyebrow">{t("blog:topper")}</span>
				<span class="cap-rule"></span>
				<h2 class="cap-h2">{t("blog:title")}</h2>
			</header>

			<ul class="cap-blog-grid">
				{page.data.map((post) => <BlogPreview post={post} />)}
			</ul>

			<Pagination page={page} />
		</div>
	</section>

	<CTA />
</BaseLayout>

<style lang="less">
	.cap-section-head {
		margin-bottom: 2.5rem;
	}
	.cap-blog-grid {
		list-style: none;
		padding: 0;
		margin: 0 0 3rem;
		display: grid;
		grid-template-columns: 1fr;
		gap: 2rem;
	}
	@media (min-width: 40rem) {
		.cap-blog-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}
	@media (min-width: 64rem) {
		.cap-blog-grid {
			grid-template-columns: repeat(3, 1fr);
		}
	}
</style>
