---
import { Image } from "astro:assets";
import { formatDate } from "@js/utils";
import { getLocaleFromUrl, getPostSlug } from "@js/localeUtils";
import { useTranslations, getLocalizedRoute } from "@js/translationUtils";

const { post } = Astro.props;
const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const slug = getPostSlug(post);
const { title, date, description, image, imageAlt } = post.data;
---

<li class="cap-post-card">
	<a href={getLocalizedRoute(locale, `/blog/${slug}`)} class="cap-post-card-img-link" tabindex="-1" aria-hidden="true">
		<Image src={image} alt={imageAlt} class="cap-post-card-img" widths={[480, 800]} sizes="(min-width: 64rem) 30vw, (min-width: 40rem) 50vw, 100vw" loading="lazy" />
	</a>
	<div class="cap-post-card-body">
		<span class="cap-post-card-date">{formatDate(date)}</span>
		<h3 class="cap-post-card-title">
			<a href={getLocalizedRoute(locale, `/blog/${slug}`)}>{title}</a>
		</h3>
		<p class="cap-post-card-excerpt">{description}</p>
		<a href={getLocalizedRoute(locale, `/blog/${slug}`)} class="cap-post-card-link" aria-label={`${t("blog:readMore")}: ${title}`}>
			{t("blog:readMore")}
			<svg class="cap-post-card-arrow" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
				<path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
			</svg>
		</a>
	</div>
</li>

<style lang="less">
	.cap-post-card {
		list-style: none;
		display: flex;
		flex-direction: column;
		background-color: rgba(255, 255, 255, 0.03);
		border: 1px solid rgba(207, 183, 153, 0.15);
		overflow: hidden;
		transition: border-color 0.3s ease, transform 0.3s ease;

		&:hover {
			border-color: rgba(207, 183, 153, 0.5);
			transform: translateY(-3px);

			.cap-post-card-img {
				transform: scale(1.04);
			}
		}
	}

	.cap-post-card-img-link {
		display: block;
		overflow: hidden;
		aspect-ratio: 3 / 2;
		flex: none;
	}

	.cap-post-card-img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		transition: transform 0.6s ease;
	}

	.cap-post-card-body {
		padding: 1.75rem;
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		flex: 1;
	}

	.cap-post-card-date {
		font-family: var(--font-gotham);
		font-size: 0.6875rem;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: var(--gold);
	}

	.cap-post-card-title {
		font-family: var(--font-empera);
		font-size: clamp(1.25rem, 2.2vw, 1.625rem);
		line-height: 1.15;
		text-transform: uppercase;
		color: var(--white);
		margin: 0;

		a {
			color: inherit;
			text-decoration: none;
			transition: color 0.2s ease;

			&:hover,
			&:focus-visible {
				color: var(--gold);
			}
		}
	}

	.cap-post-card-excerpt {
		font-family: var(--font-gotham);
		font-size: 0.9375rem;
		line-height: 1.6;
		color: var(--lightGray);
		flex: 1;
	}

	.cap-post-card-link {
		font-family: var(--font-gotham);
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--gold);
		text-decoration: none;
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		margin-top: 0.5rem;
		transition: gap 0.2s ease;

		&:hover,
		&:focus-visible {
			gap: 0.75rem;
		}
	}

	.cap-post-card-arrow {
		flex: none;
		transition: transform 0.2s ease;
	}

	.cap-post-card-link:hover .cap-post-card-arrow,
	.cap-post-card-link:focus-visible .cap-post-card-arrow {
		transform: translateX(3px);
	}
</style>
