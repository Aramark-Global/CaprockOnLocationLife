---
import { Image } from "astro:assets";
import { BUSINESS } from "@data/client";
import navData from "@data/navData.json";
import { getCurrentYear } from "@js/utils";
import { getLocaleFromUrl } from "@js/localeUtils";
import { useTranslations, getLocalizedRoute } from "@js/translationUtils";
import logoWhite from "@assets/logos/Caprock-Secondary-4C.png";

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const currentYear = getCurrentYear();
---

<footer id="cap-footer">
	<div class="cap-footer-inner">
		<div class="cap-footer-brand">
			<a class="cap-footer-logo" href={getLocalizedRoute(locale, "/")} aria-label="Caprock — home">
				<Image src={logoWhite} alt="Caprock" width={480} height={120} loading="lazy" decoding="async" />
			</a>
			<p class="cap-footer-tagline">{t("footer.tagline")}</p>
		</div>

		<div class="cap-footer-cols">
			<section class="cap-footer-col">
				<h2 class="cap-footer-heading">{t("footer.explore")}</h2>
				<ul>
					{
						navData.map((entry: any) => (
							<li>
								<a href={getLocalizedRoute(locale, entry.url)}>{entry.label[locale]}</a>
							</li>
						))
					}
				</ul>
			</section>

			<section class="cap-footer-col">
				<h2 class="cap-footer-heading">{t("footer.visit")}</h2>
				<ul>
					<li>
						<a href={BUSINESS.address.mapLink} target="_blank" rel="noopener">
							{BUSINESS.address.lineOne}<br />
							{BUSINESS.address.city} {BUSINESS.address.state} {BUSINESS.address.zip}
						</a>
					</li>
				</ul>
			</section>

			<section class="cap-footer-col">
				<h2 class="cap-footer-heading">{t("footer.connect")}</h2>
				<ul>
					<li>
						<a href={`tel:${BUSINESS.phoneForTel}`}>{BUSINESS.phoneFormatted}</a>
					</li>
					<li>
						<a href={`mailto:${BUSINESS.email}`}>{BUSINESS.email}</a>
					</li>
				</ul>
			</section>
		</div>
	</div>

	<div class="cap-footer-base">
		<span>© {currentYear} {BUSINESS.name}. {t("footer.rights")}</span>
	</div>
</footer>

<style lang="less">
	#cap-footer {
		background-color: var(--black);
		color: var(--white);
		padding: clamp(3.5rem, 8vw, 6rem) 0 0;
		font-family: var(--font-gotham);
	}

	.cap-footer-inner {
		max-width: var(--maxWidth);
		margin-inline: auto;
		padding-inline: var(--gutter);
		display: grid;
		grid-template-columns: 1fr;
		gap: 3rem;
		padding-bottom: 3rem;
	}

	.cap-footer-brand {
		max-width: 22rem;
	}

	.cap-footer-logo {
		line-height: 0;
		display: inline-block;
	}

	.cap-footer-logo img {
		display: block;
		height: 2.75rem;
		width: auto;
		max-width: 15rem;
		object-fit: contain;
		margin-bottom: 1.5rem;
	}

	.cap-footer-tagline {
		font-family: var(--font-gelica);
		font-style: italic;
		font-size: 1.0625rem;
		color: var(--lightGray);
		line-height: 1.5;
	}

	.cap-footer-cols {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
		gap: 2.5rem;
	}

	.cap-footer-col {
		ul {
			list-style: none;
			padding: 0;
			margin: 0;
			display: flex;
			flex-direction: column;
			gap: 0.625rem;
		}

		a {
			color: var(--lightGray);
			font-size: 0.9375rem;
			line-height: 1.5;
			transition: color 0.2s ease;

			&:hover,
			&:focus-visible {
				color: var(--gold);
			}
		}
	}

	.cap-footer-heading {
		font-family: var(--font-gotham);
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.22em;
		text-transform: uppercase;
		color: var(--gold);
		margin: 0 0 1.25rem;
		padding-bottom: 0.625rem;
		border-bottom: 1px solid rgba(207, 183, 153, 0.25);
	}

	.cap-footer-base {
		border-top: 1px solid rgba(255, 255, 255, 0.08);
		padding: 1.5rem var(--gutter);
		max-width: var(--maxWidth);
		margin-inline: auto;
		font-size: 0.8125rem;
		letter-spacing: 0.05em;
		color: var(--lightGray);
		text-align: center;
	}

	@media only screen and (min-width: 48rem) {
		.cap-footer-inner {
			grid-template-columns: 1fr 1.5fr;
			align-items: start;
			gap: 4rem;
		}
		.cap-footer-base {
			text-align: left;
		}
	}
</style>
