---
import { getLocaleFromUrl } from "@js/localeUtils";
import { useTranslations, getLocalizedPathname } from "@js/translationUtils";
import { locales, languageSwitcherMap } from "@config/siteSettings";

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

const otherLocale = locales.find((l) => l !== locale) ?? locales[0];
const otherHref = await getLocalizedPathname(otherLocale, Astro.url);
---

<a
  href={otherHref}
  class="lang-toggle"
  hreflang={otherLocale}
  aria-label={`${t("language-label")}: ${t(`languageSelect.${otherLocale}`)}`}
>
  <span class="lang-active" aria-hidden="true">{languageSwitcherMap[locale]}</span>
  <span class="lang-sep" aria-hidden="true">/</span>
  <span class="lang-other" aria-hidden="true">{languageSwitcherMap[otherLocale]}</span>
</a>

<style lang="less">
  .lang-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    text-decoration: none;
    font-family: "Gotham", var(--font-body, "Montserrat"), system-ui, sans-serif;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    line-height: 1;
    padding: 0.35rem 0.65rem;
    border: 1px solid rgba(207, 183, 153, 0.35);
    border-radius: 2px;
    transition: border-color 0.2s ease, background-color 0.2s ease;

    &:hover,
    &:focus-visible {
      border-color: var(--gold);
      background-color: rgba(207, 183, 153, 0.08);
      outline: none;
    }

    &:focus-visible {
      outline: 2px solid var(--gold);
      outline-offset: 2px;
    }
  }

  .lang-active {
    color: var(--gold);
  }

  .lang-sep {
    color: rgba(255, 255, 255, 0.2);
    font-weight: 400;
    letter-spacing: 0;
  }

  .lang-other {
    color: rgba(255, 255, 255, 0.35);
  }
</style>
