---
import BaseLayout from "@layouts/BaseLayout.astro";
import { Image, Picture } from "astro:assets";
import { getLocaleFromUrl } from "@js/localeUtils";
import { useTranslations, getLocalizedRoute } from "@js/translationUtils";
import BrowserLanguageRedirect from "@components/LanguageSwitch/BrowserLanguageRedirect.astro";

import heroImg from "@assets/images/AdobeStock.jpeg";
import housingImg from "@assets/images/sample-images/5c44868359773af0ba2f990a2d7858cf.jpg";
import diningImg from "@assets/images/sample-images/c7c493ea99ee39aff6454dcc5196b3ff.jpg";
import emblem from "@assets/logos/Caprock-Emblem-Iso-white.png";
import ramrodeoImg from "@assets/images/sample-images/41171235363574b777c8f2f1e8daf86ad0b99d01-1200x800.webp";
import ctaImg from "@assets/images/sample-images/ram-rodeo-yun-wang.jpg";
import { BUSINESS } from "@data/client";

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

const amenities = t<Array<{ title: string; desc: string }>>("home:amenities.items");
const features = t<string[]>("home:housing.features");
const comingSoon = t<Array<{ title: string; desc: string }>>("home:comingSoon.items");
---

<BrowserLanguageRedirect />

<BaseLayout
	title={t("home:layout.title")}
	description={t("home:layout.description")}
>
	<!-- ===================== HERO ===================== -->
	<section id="cap-hero" class="cap-hero">
		<Picture
			src={heroImg}
			alt=""
			formats={["avif", "webp"]}
			widths={[640, 1024, 1600, 2000]}
			sizes="100vw"
			pictureAttributes={{ class: "cap-hero-bg" }}
			aria-hidden="true"
			loading="eager"
		/>
		<div class="cap-hero-scrim" aria-hidden="true"></div>
		<div class="cap-hero-content cap-container">
			<Image src={emblem} alt="" width={72} height={72} class="cap-hero-emblem" aria-hidden="true" />
			<span class="cap-eyebrow cap-hero-eyebrow">{t("home:hero.eyebrow")}</span>
			<h1 class="cap-hero-title">{t("home:hero.title")}</h1>
			<p class="cap-sub cap-hero-sub">{t("home:hero.subtitle")}</p>
			<p class="cap-hero-intro">{t("home:hero.intro")}</p>
			<div class="cap-hero-ctas">
				<a href="#cap-life-on-site" class="cap-btn">{t("home:hero.scroll")}</a>
			</div>
		</div>
	</section>

	<!-- ===================== INTRO ===================== -->
	<section id="cap-intro" class="cap-section cap-section--light">
		<div class="cap-container cap-intro-grid">
			<div class="cap-intro-head">
				<span class="cap-eyebrow">{t("home:intro.eyebrow")}</span>
				<span class="cap-rule"></span>
				<h2 class="cap-h2">{t("home:intro.title")}</h2>
			</div>
			<div class="cap-intro-body">
				<p class="cap-lead">{t("home:intro.p1")}</p>
				<p>{t("home:intro.p2")}</p>
			</div>
		</div>
	</section>

	<!-- ===================== AMENITIES ===================== -->
	<section
		id="cap-life-on-site"
		class="cap-section cap-amenities-parallax"
		style={`--amenities-bg: url('${ramrodeoImg.src}')`}
	>
		<div class="cap-amenities-overlay" aria-hidden="true"></div>
		<div class="cap-container cap-amenities-content">
			<header class="cap-section-head">
				<span class="cap-eyebrow">{t("home:amenities.eyebrow")}</span>
				<span class="cap-rule"></span>
				<h2 class="cap-h2">{t("home:amenities.title")}</h2>
				<p class="cap-section-intro">{t("home:amenities.intro")}</p>
			</header>

			<ul class="cap-amenities-grid">
				{
					amenities.map((item, idx) => (
						<li class="cap-amenity">
							<span class="cap-amenity-num">{String(idx + 1).padStart(2, "0")}</span>
							<h3 class="cap-h3">{item.title}</h3>
							<p>{item.desc}</p>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<!-- ===================== COMING SOON ===================== -->
	<section class="cap-section cap-section--light cap-coming-soon">
		<div class="cap-container">
			<header class="cap-section-head">
				<span class="cap-eyebrow">{t("home:comingSoon.eyebrow")}</span>
				<span class="cap-rule"></span>
				<h2 class="cap-h2">{t("home:comingSoon.title")}</h2>
			</header>
			<ul class="cap-coming-soon-grid">
				{
					comingSoon.map((item) => (
						<li class="cap-coming-soon-item">
							<h3 class="cap-h3">{item.title}</h3>
							<p>{item.desc}</p>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<!-- ===================== HOUSING (Split) ===================== -->
	<section id="cap-housing" class="cap-section cap-section--light cap-split">
		<div class="cap-container cap-split-grid">
			<div class="cap-split-media">
				<Picture
					src={housingImg}
					alt="Caprock housing accommodations"
					formats={["avif", "webp"]}
					widths={[480, 800, 1200]}
					sizes="(min-width: 64rem) 50vw, 100vw"
					loading="lazy"
				/>
			</div>
			<div class="cap-split-body">
				<span class="cap-eyebrow">{t("home:housing.eyebrow")}</span>
				<span class="cap-rule"></span>
				<h2 class="cap-h2">{t("home:housing.title")}</h2>
				<p class="cap-lead">{t("home:housing.p1")}</p>
				<ul class="cap-feature-list">
					{features.map((feat) => <li>{feat}</li>)}
				</ul>
			</div>
		</div>
	</section>

	<!-- ===================== DINING TEASER ===================== -->
	<section class="cap-section cap-section--light cap-split cap-split--reverse">
		<div class="cap-container cap-split-grid">
			<div class="cap-split-media">
				<Picture
					src={diningImg}
					alt="On-site dining at Caprock"
					formats={["avif", "webp"]}
					widths={[480, 800, 1200]}
					sizes="(min-width: 64rem) 50vw, 100vw"
					loading="lazy"
				/>
			</div>
			<div class="cap-split-body">
				<span class="cap-eyebrow">{locale === "es" ? "Comedor" : "Dining"}</span>
				<span class="cap-rule"></span>
				<h2 class="cap-h2">
					{locale === "es"
						? "Comidas pensadas en cada turno."
						: "Meals built around every shift."}
				</h2>
				<p class="cap-lead">
					{locale === "es"
						? "Desayuno antes del turno temprano, cena con compañeros o algo rápido entre horarios — el comedor de Caprock está diseñado para acompañar todo el día."
						: "Breakfast before an early shift, dinner with coworkers, or a quick bite between schedules — dining at Caprock is built to support every part of the day."}
				</p>
			</div>
		</div>
	</section>

	<!-- ===================== FINAL CTA ===================== -->
	<section
		id="cap-contact"
		class="cap-cta-new"
		style={`--cta-bg: url('${ctaImg.src}')`}
	>
		<div class="cap-cta-overlay" aria-hidden="true"></div>
		<div class="cap-container cap-cta-grid">

			<!-- Messaging -->
			<div class="cap-cta-messaging">
				<Image
					src={emblem}
					alt=""
					width={72}
					height={72}
					class="cap-cta-emblem"
					aria-hidden="true"
					loading="lazy"
				/>
				<span class="cap-eyebrow cap-cta-eyebrow">{t("home:cta.eyebrow")}</span>
				<span class="cap-rule"></span>
				<h2 class="cap-cta-title">{t("home:cta.title")}</h2>
				<p class="cap-cta-sub">{t("home:cta.subtitle")}</p>
				<div class="cap-cta-btns">
					<a href={`mailto:${BUSINESS.email}`} class="cap-btn">{t("home:cta.button")}</a>
				</div>
			</div>

			<!-- Contact card -->
			<div class="cap-cta-contact">
				<div class="cap-cta-contact-item">
					<span class="cap-cta-contact-label">{t("home:cta.emailLabel")}</span>
					<a href={`mailto:${BUSINESS.email}`} class="cap-cta-contact-value">{BUSINESS.email}</a>
				</div>
				<div class="cap-cta-divider" aria-hidden="true"></div>
				<div class="cap-cta-contact-item">
					<span class="cap-cta-contact-label">{t("home:cta.visitLabel")}</span>
					<a href={BUSINESS.address.mapLink} target="_blank" rel="noopener" class="cap-cta-contact-value">
						{BUSINESS.address.lineOne}<br />
						{BUSINESS.address.city} {BUSINESS.address.state} {BUSINESS.address.zip}
					</a>
				</div>
			</div>

		</div>
	</section>
</BaseLayout>

<style lang="less">
	/* HERO */
	.cap-hero {
		position: relative;
		min-height: 92vh;
		display: flex;
		align-items: center;
		color: var(--white);
		overflow: hidden;
	}
	:global(.cap-hero-bg) {
		position: absolute;
		inset: 0;
		z-index: 0;
		img {
			width: 100%;
			height: 100%;
			object-fit: cover;
		}
	}
	.cap-hero-scrim {
		position: absolute;
		inset: 0;
		background-color: rgba(0, 0, 0, 0.45);
		z-index: 1;
	}
	.cap-hero-content {
		position: relative;
		z-index: 2;
		padding-block: clamp(5rem, 12vw, 9rem);
		max-width: 60rem;
	}
	.cap-hero-emblem {
		width: 4rem;
		height: auto;
		margin-bottom: 1.75rem;
		opacity: 0.95;
	}
	.cap-hero-eyebrow {
		color: var(--gold);
		margin-bottom: 1.5rem;
	}
	:global(.cap-hero-title) {
		color: var(--white);
		max-width: 18ch;
		margin-bottom: 1.5rem;
	}
	.cap-hero-sub {
		color: var(--lightGray);
		margin-bottom: 2rem;
		max-width: 30ch;
	}
	.cap-hero-intro {
		color: var(--lightGray);
		max-width: 40rem;
		margin-bottom: 2.5rem;
		font-size: clamp(1rem, 1.4vw, 1.125rem);
	}
	.cap-hero-ctas {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
	}

	/* INTRO */
	.cap-intro-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 2.5rem;
	}
	.cap-intro-body p + p {
		margin-top: 1.25rem;
	}
	@media (min-width: 64rem) {
		.cap-intro-grid {
			grid-template-columns: 1fr 1.4fr;
			gap: 5rem;
			align-items: start;
		}
	}

	/* SECTION HEAD */
	.cap-section-head {
		max-width: 44rem;
		margin-bottom: 3.5rem;
	}
	.cap-section-intro {
		margin-top: 1.5rem;
		max-width: 38rem;
	}

	/* COMING SOON */
	.cap-coming-soon-grid {
		list-style: none;
		padding: 0;
		display: grid;
		grid-template-columns: 1fr;
		gap: 2rem;

		@media (min-width: 40rem) {
			grid-template-columns: repeat(2, 1fr);
		}
		@media (min-width: 64rem) {
			grid-template-columns: repeat(3, 1fr);
		}
	}
	.cap-coming-soon-item {
		border-left: 2px solid var(--gold);
		padding-left: 1.5rem;

		h3 {
			margin-bottom: 0.5rem;
		}
		p {
			font-size: 0.9375rem;
			color: var(--bodyText);
		}
	}

	/* AMENITIES */
	.cap-amenities-parallax {
		position: relative;
		background-image: var(--amenities-bg);
		background-size: cover;
		background-position: center;
		background-attachment: fixed;
		background-repeat: no-repeat;
		color: var(--white);

		@media (max-width: 63.9375rem) {
			background-attachment: scroll;
		}
	}
	.cap-amenities-overlay {
		position: absolute;
		inset: 0;
		background-color: rgba(0, 0, 0, 0.78);
		z-index: 0;
	}
	.cap-amenities-content {
		position: relative;
		z-index: 1;
	}
	.cap-amenities-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1px;
		background-color: rgba(255, 255, 255, 0.08);
		border-top: 1px solid rgba(255, 255, 255, 0.08);
		border-bottom: 1px solid rgba(255, 255, 255, 0.08);
		padding: 0;
		list-style: none;
	}
	.cap-amenity {
		background-color: rgba(0, 0, 0, 0.55);
		padding: 2.25rem 1.75rem;
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		transition: background-color 0.25s ease;

		&:hover {
			background-color: rgba(0, 0, 0, 0.35);
		}

		p {
			color: var(--lightGray);
			font-size: 0.9375rem;
		}
	}
	.cap-amenity-num {
		font-family: var(--font-empera);
		font-size: 0.875rem;
		letter-spacing: 0.2em;
		color: var(--gold);
	}
	@media (min-width: 40rem) {
		.cap-amenities-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}
	@media (min-width: 64rem) {
		.cap-amenities-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	/* SPLIT */
	.cap-split-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 2.5rem;
		align-items: center;
	}
	.cap-split-media :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		aspect-ratio: 4 / 5;
		display: block;
	}
	.cap-split-body p {
		margin-top: 1.25rem;
	}
	.cap-feature-list {
		list-style: none;
		padding: 0;
		margin: 2rem 0;
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.875rem 1.5rem;

		li {
			font-family: var(--font-gotham);
			font-size: 0.9375rem;
			padding-left: 1.5rem;
			position: relative;

			&::before {
				content: "";
				position: absolute;
				left: 0;
				top: 0.625rem;
				width: 0.625rem;
				height: 1px;
				background-color: var(--gold);
			}
		}
	}
	@media (min-width: 64rem) {
		.cap-split-grid {
			grid-template-columns: 1fr 1fr;
			gap: 5rem;
		}
		.cap-split--reverse .cap-split-grid {
			direction: rtl;
		}
		.cap-split--reverse .cap-split-grid > * {
			direction: ltr;
		}
		.cap-split-media :global(img) {
			aspect-ratio: 4 / 5;
		}
	}

	/* FINAL CTA */
	.cap-cta-new {
		position: relative;
		background-image: var(--cta-bg);
		background-size: cover;
		background-position: center 30%;
		background-attachment: fixed;
		background-repeat: no-repeat;
		padding: clamp(5rem, 12vw, 9rem) 0;

		@media (max-width: 63.9375rem) {
			background-attachment: scroll;
		}
	}
	.cap-cta-overlay {
		position: absolute;
		inset: 0;
		background-color: rgba(0, 0, 0, 0.84);
		z-index: 0;
	}
	.cap-cta-grid {
		position: relative;
		z-index: 1;
		display: grid;
		grid-template-columns: 1fr;
		gap: 4rem;
		align-items: center;
	}
	.cap-cta-messaging {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
	}
	.cap-cta-emblem {
		width: 4rem;
		height: auto;
		opacity: 0.55;
	}
	.cap-cta-eyebrow {
		color: var(--gold);
	}
	.cap-cta-title {
		font-family: var(--font-empera);
		font-size: clamp(2.75rem, 6vw, 5rem);
		color: var(--white);
		text-transform: uppercase;
		line-height: 1.0;
		max-width: 18ch;
	}
	.cap-cta-sub {
		font-family: var(--font-gelica);
		font-style: italic;
		font-size: clamp(1.125rem, 1.8vw, 1.375rem);
		color: var(--lightGray);
		max-width: 34ch;
	}
	.cap-cta-btns {
		display: flex;
		gap: 1rem;
		flex-wrap: wrap;
		margin-top: 0.5rem;
	}
	.cap-cta-contact {
		border: 1px solid rgba(207, 183, 153, 0.35);
		display: flex;
		flex-direction: column;
	}
	.cap-cta-divider {
		height: 1px;
		background-color: rgba(207, 183, 153, 0.2);
	}
	.cap-cta-contact-item {
		padding: 1.75rem 2rem;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}
	.cap-cta-contact-label {
		font-family: var(--font-gotham);
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: var(--gold);
	}
	.cap-cta-contact-value {
		font-family: var(--font-gotham);
		font-size: clamp(1.125rem, 2vw, 1.5rem);
		color: var(--white);
		text-decoration: none;
		line-height: 1.3;
		transition: color 0.2s ease;

		&:hover,
		&:focus-visible {
			color: var(--gold);
		}
	}
	@media (min-width: 64rem) {
		.cap-cta-grid {
			grid-template-columns: 1.2fr 1fr;
			gap: 6rem;
		}
	}
</style>
