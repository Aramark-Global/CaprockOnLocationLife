---
import BaseLayout from "@layouts/BaseLayout.astro";
import { getLocaleFromUrl } from "@js/localeUtils";
import { useTranslations, getLocalizedRoute } from "@js/translationUtils";

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const title = t("notFound.pageNotFound");
---

<BaseLayout title={title} description={title}>
  <section class="cap-404 cap-section cap-section--dark">
    <div class="cap-container cap-404-inner">
      <span class="cap-eyebrow">404</span>
      <span class="cap-rule"></span>
      <h1 class="cap-h2">{title}</h1>
      <a href={getLocalizedRoute(locale, "/")} class="cap-btn">{t("notFound.linkText")}</a>
    </div>
  </section>
</BaseLayout>

<style lang="less">
  .cap-404 {
    min-height: 70vh;
    display: flex;
    align-items: center;
  }
  .cap-404-inner {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
  }
</style>
