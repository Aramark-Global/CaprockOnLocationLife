---
import BaseLayout from "@layouts/BaseLayout.astro";
import { Picture } from "astro:assets";
import { getLocaleFromUrl } from "@js/localeUtils";
import { useTranslations } from "@js/translationUtils";

import bannerImg from "@assets/images/sample-images/coyote-bluff-amarillo-1024x768.jpg";
import storyImg from "@assets/images/sample-images/87236e4b68901abdad43804dbad863e8.jpg";
import CTA from "@components/CTA/CTA.astro";

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

const values = t<Array<{ title: string; desc: string }>>("about:values.items");
---

<BaseLayout
	title={t("about:layout.title")}
	description={t("about:layout.description")}
>
	<!-- ===================== BANNER ===================== -->
	<section class="cap-about-banner">
		<Picture
			src={bannerImg}
			alt=""
			formats={["avif", "webp"]}
			widths={[640, 1024, 1600, 2000]}
			sizes="100vw"
			pictureAttributes={{ class: "cap-about-bg" }}
			aria-hidden="true"
			loading="eager"
		/>
		<div class="cap-about-scrim" aria-hidden="true"></div>
		<div class="cap-about-banner-content cap-container">
			<span class="cap-eyebrow cap-banner-eyebrow">{t("about:hero.eyebrow")}</span>
			<h1 class="cap-hero-title cap-about-title">{t("about:hero.title")}</h1>
			<p class="cap-sub cap-about-sub">{t("about:hero.subtitle")}</p>
		</div>
	</section>

	<!-- ===================== STORY ===================== -->
	<section class="cap-section cap-section--light">
		<div class="cap-container cap-about-story">
			<div class="cap-about-story-media">
				<Picture
					src={storyImg}
					alt="Caprock community"
					formats={["avif", "webp"]}
					widths={[480, 800, 1200]}
					sizes="(min-width: 64rem) 45vw, 100vw"
					loading="lazy"
				/>
			</div>
			<div class="cap-about-story-body">
				<span class="cap-eyebrow">{t("about:story.eyebrow")}</span>
				<span class="cap-rule"></span>
				<h2 class="cap-h2">{t("about:story.title")}</h2>
				<p class="cap-lead">{t("about:story.p1")}</p>
				<p>{t("about:story.p2")}</p>
			</div>
		</div>
	</section>

	<!-- ===================== VALUES ===================== -->
	<section class="cap-section cap-section--dark">
		<div class="cap-container">
			<header class="cap-section-head">
				<span class="cap-eyebrow">{t("about:values.eyebrow")}</span>
				<span class="cap-rule"></span>
				<h2 class="cap-h2">{t("about:values.title")}</h2>
			</header>

			<ul class="cap-values-grid">
				{
					values.map((v, i) => (
						<li class="cap-value">
							<span class="cap-value-num">{String(i + 1).padStart(2, "0")}</span>
							<h3 class="cap-h3">{v.title}</h3>
							<p>{v.desc}</p>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<!-- ===================== CTA ===================== -->
	<CTA />
</BaseLayout>

<style lang="less">
	.cap-about-banner {
		position: relative;
		min-height: 60vh;
		display: flex;
		align-items: center;
		color: var(--white);
		overflow: hidden;
	}
	:global(.cap-about-bg) {
		position: absolute;
		inset: 0;
		z-index: 0;
		img {
			width: 100%;
			height: 100%;
			object-fit: cover;
		}
	}
	.cap-about-scrim {
		position: absolute;
		inset: 0;
		background-color: rgba(0, 0, 0, 0.65);
		z-index: 1;
	}
	.cap-about-banner-content {
		position: relative;
		z-index: 2;
		padding-block: clamp(4rem, 10vw, 7rem);
		max-width: 50rem;
	}
	.cap-banner-eyebrow {
		color: var(--gold);
		margin-bottom: 1.25rem;
	}
	:global(.cap-about-title) {
		color: var(--white);
		max-width: 20ch;
		margin-bottom: 1.25rem;
		font-size: clamp(2.25rem, 6vw, 5rem);
	}
	.cap-about-sub {
		color: var(--lightGray);
		max-width: 36ch;
	}

	/* STORY */
	.cap-about-story {
		display: grid;
		grid-template-columns: 1fr;
		gap: 2.5rem;
		align-items: center;
	}
	.cap-about-story-media :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		aspect-ratio: 4 / 5;
		display: block;
	}
	.cap-about-story-body p {
		margin-top: 1.25rem;
	}
	@media (min-width: 64rem) {
		.cap-about-story {
			grid-template-columns: 1fr 1.2fr;
			gap: 5rem;
		}
	}

	/* VALUES */
	.cap-section-head {
		margin-bottom: 2.5rem;
	}
	.cap-values-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1px;
		background-color: rgba(255, 255, 255, 0.08);
		border-top: 1px solid rgba(255, 255, 255, 0.08);
		border-bottom: 1px solid rgba(255, 255, 255, 0.08);
		padding: 0;
		list-style: none;
	}
	.cap-value {
		background-color: var(--black);
		padding: 2.25rem 1.75rem;
		display: flex;
		flex-direction: column;
		gap: 0.75rem;

		p {
			color: var(--lightGray);
			font-size: 0.9375rem;
		}
	}
	.cap-value-num {
		font-family: var(--font-empera);
		font-size: 0.875rem;
		letter-spacing: 0.2em;
		color: var(--gold);
	}
	@media (min-width: 40rem) {
		.cap-values-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}
	@media (min-width: 64rem) {
		.cap-values-grid {
			grid-template-columns: repeat(4, 1fr);
		}
	}


</style>
